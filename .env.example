# Gemini / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=vertex_ai/gemini-3.5-flash-lite

# Google Maps Platform server key. Restrict it to Places API (New) and Routes API.
# Never expose this value in frontend JavaScript or commit a real key.
GOOGLE_MAPS_API_KEY=your-server-api-key

# Lightweight safeguards for process-local conversation memory.
SESSION_TTL_SECONDS=7200
MAX_SESSIONS=500

# Bounded Deep Research execution. Keep the total Cloud Run request timeout below
# the course's five-minute grading allowance.
RESEARCH_TASK_TIMEOUT_SECONDS=45
RESEARCH_MAX_TURNS=6
